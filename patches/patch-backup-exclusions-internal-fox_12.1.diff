--- a/partition.cpp
+++ b/partition.cpp
@@ -686,6 +686,25 @@
 		Setup_Data_Partition(Display_Error);
 	else if (Mount_Point == "/cache")
 		Setup_Cache_Partition(Display_Error);
+
+#ifdef TW_BACKUP_EXCLUSIONS
+	// backup_exclusions is a per-partition member, and the TW_BACKUP_EXCLUSIONS
+	// list is otherwise only read in Setup_Data_Media(), which runs for /data
+	// alone. /data already excludes /data/media wholesale, so board-defined
+	// exclusions could never affect anything. Apply them to every partition
+	// here instead, which is what a board-level exclusion list implies -- and
+	// what makes them reach an internal-storage mount point such as /storage.
+	{
+		std::vector<std::string> board_exclusions = TWFunc::Split_String(TW_BACKUP_EXCLUSIONS, ",");
+		for (const std::string& excl : board_exclusions) {
+			std::string trimmed = TWFunc::trim(excl);
+			if (!trimmed.empty()) {
+				backup_exclusions.add_absolute_dir(trimmed);
+				LOGINFO("Board exclusion '%s' added to partition '%s'\n", trimmed.c_str(), Mount_Point.c_str());
+			}
+		}
+	}
+#endif
 }
 
