+// Keep archive passwords out of the log. An encrypted archive is created with
+// the password on the command line, and recovery logs are copied to internal
+// storage, so logging the command verbatim would leave the password sitting
+// next to the archive it protects.
+static std::string redact_secrets(const std::string& command) {
+	if (command.find("/tmp/of_packpw") != std::string::npos &&
+	    command.find("printf") != std::string::npos)
+		return "<password written to /tmp/of_packpw>";
+
+	std::string out = command;
+	size_t at = out.find(" -p");
+	while (at != std::string::npos) {
+		size_t from = at + 3;
+		size_t to = out.find(' ', from);
+		if (to == std::string::npos)
+			to = out.size();
+		if (to > from)
+			out.replace(from, to - from, "***");
+		at = out.find(" -p", from + 3);
+	}
+	return out;
+}
