 int Log_Offset;
 bool datamedia;
 
+// Pure logging, no functional effect: prints /proc/uptime at named boot
+// checkpoints so a phase timeline can be read straight out of recovery.log.
+static void Fox_Log_Boot_Timing(const char* phase) {
+	FILE* f = fopen("/proc/uptime", "r");
+	double uptime = 0.0;
+	if (f) {
+		if (fscanf(f, "%lf", &uptime) != 1)
+			uptime = 0.0;
+		fclose(f);
+	}
+	LOGINFO("BOOT_TIMING: %-28s t=%.2fs\n", phase, uptime);
+}
+
 static void Print_Prop(const char *key, const char *name, void *cookie) {
